# Copy this file to .env.local for development, then fill in the values.
# On Vercel, set the SAME NAMES under Settings > Environment Variables.
# Never put a real secret in this file. It is committed to GitHub.

# REQUIRED. A long random value that signs login cookies.
# Use a DIFFERENT value in Development, Preview and Production.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# OPTIONAL. Only for a custom domain, and only in Production, for example https://mesob.example.com
# Leave it unset otherwise. On Vercel the site URL is detected automatically.
SITE_URL=

# OPTIONAL. Set to "true" to show the "Continue as Raniya (demo)" button
# and to allow the ?demo=slow|empty|error screens.
# Safe only because all data is fake. Never enable it on a site with real customers.
DEMO_LOGIN=

# NOT USED YET. The app uses an in-memory mock database.
# DATABASE_URL=